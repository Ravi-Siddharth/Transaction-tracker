{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "transaction-frontend": {
      "root": "transaction-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
        "source": "/(.*)",
        "destination":{
            "service": "transaction-frontend"
        }
    }
  ]
}
